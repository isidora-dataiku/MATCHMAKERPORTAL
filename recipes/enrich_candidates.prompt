  "rawResponseOutputMode": "RAW_WITHOUT_TRACES",
  "llmId": "openai:OpenAI:gpt-4.1-mini",
  "prompt": {
    "guardrailsPipelineSettings": {
      "guardrails": []
    },
    "promptTemplateInputs": [],
    "resultValidation": {
      "requiredJSONObjectKeys": [],
      "expectedFormat": "NONE",
      "forbiddenTerms": []
    },
    "promptTemplateQueriesSource": "DATASET",
    "streamingDisabled": false,
    "chatMessages": {},
    "structuredPromptExamples": [],
    "textPromptTemplate": "Analyseer dit kandidaatprofiel en geef een JSON object met exact deze 4 velden:\n  1. \"profiel_samenvatting\": beknopte Nederlandse samenvatting van het profiel (max 100 woorden)\n  2. \"vaardigheden_gestandaardiseerd\": JSON array met genormaliseerde vaardigheden (strings)\n  3. \"carriere_niveau\": exact \"junior\", \"medior\" of \"senior\" op basis van werkervaring\n  4. \"sector_voorkeur\": de meest waarschijnlijke sectorkeuze (één woord of korte frase)\n\n  Kandidaat gegevens:\n  - Laatste functie: {{laatste_functie}}\n  - Werkervaring: {{werkervaring_jaren}} jaar\n  - Opleiding: {{opleiding_niveau}} in {{opleiding_richting}}\n  - Vaardigheden: {{vaardigheden_raw}}\n  - Beschikbaarheid: {{beschikbaarheid}}\n\n  Geef ALLEEN het JSON object terug, geen verdere tekst.",
    "textPromptTemplateInputs": [
      {
        "datasetColumnName": "laatste_functie",
        "name": "laatste_functie",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "werkervaring_jaren",
        "name": "werkervaring_jaren",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "opleiding_niveau",
        "name": "opleiding_niveau",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "opleiding_richting",
        "name": "opleiding_richting",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "vaardigheden_raw",
        "name": "vaardigheden_raw",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "beschikbaarheid",
        "name": "beschikbaarheid",
        "type": "TEXT"
      }
    ],
    "textPromptSystemTemplate": "Je bent een expert in arbeidsmarkt analyse voor UWV. Analyseer kandidaatprofielen objectief op basis van professionele criteria. Geef je antwoord altijd als geldig JSON object.",
    "promptMode": "PROMPT_TEMPLATE_TEXT"
  },
  "performFiltering": false
}