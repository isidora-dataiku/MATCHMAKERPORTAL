    "promptTemplateQueriesSource": "DATASET",
    "streamingDisabled": false,
    "chatMessages": {},
    "structuredPromptExamples": [],
    "textPromptTemplate": "Analyseer deze vacature en geef een JSON object met exact deze 4 velden:\n  1. \"samenvatting\": beknopte Nederlandse samenvatting (max 150 woorden)\n  2. \"vereiste_vaardigheden_lijst\": JSON array met genormaliseerde vereiste vaardigheden (strings)\n  3. \"functieniveau\": exact \"junior\", \"medior\" of \"senior\"\n  4. \"sector_gestandaardiseerd\": genormaliseerde sectorcode (één woord: Logistiek/Zorg/ICT/Administratie/Retail/Bouw)\n\n  Vacature gegevens:\n  - Titel: {{titel}}\n  - Omschrijving: {{omschrijving}}\n  - Vereiste vaardigheden: {{vereiste_vaardigheden_raw}}\n  - Opleiding vereist: {{vereiste_opleiding}}\n  - Minimale ervaring: {{vereiste_ervaring_jaren}} jaar\n\n  Geef ALLEEN het JSON object terug, geen verdere tekst.",
    "textPromptTemplateInputs": [
      {
        "datasetColumnName": "titel",
        "name": "titel",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "omschrijving",
        "name": "omschrijving",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "vereiste_vaardigheden_raw",
        "name": "vereiste_vaardigheden_raw",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "vereiste_opleiding",
        "name": "vereiste_opleiding",
        "type": "TEXT"
      },
      {
        "datasetColumnName": "vereiste_ervaring_jaren",
        "name": "vereiste_ervaring_jaren",
        "type": "TEXT"
      }
    ],
    "textPromptSystemTemplate": "Je bent een expert in arbeidsmarkt analyse voor UWV. Analyseer vacatures objectief. Geef je antwoord altijd als geldig JSON object.",
    "promptMode": "PROMPT_TEMPLATE_TEXT",
    "structuredPromptPrefix": "Analyseer deze vacature en geef een JSON object met exact deze 4 velden:\n  1. \"samenvatting\": beknopte Nederlandse samenvatting (max 150 woorden)\n  2. \"vereiste_vaardigheden_lijst\": JSON array met genormaliseerde vereiste vaardigheden (strings)\n  3. \"functieniveau\": exact \"junior\", \"medior\" of \"senior\"\n  4. \"sector_gestandaardiseerd\": genormaliseerde sectorcode (één woord: Logistiek/Zorg/ICT/Administratie/Retail/Bouw)\n\n  Vacature gegevens:\n  - Titel: {{titel}}\n  - Omschrijving: {{omschrijving}}\n  - Vereiste vaardigheden: {{vereiste_vaardigheden_raw}}\n  - Opleiding vereist: {{vereiste_opleiding}}\n  - Minimale ervaring: {{vereiste_ervaring_jaren}} jaar\n\n  Geef ALLEEN het JSON object terug, geen verdere tekst."
